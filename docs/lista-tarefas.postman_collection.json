{
  "info": {
    "name": "Lista de Tarefas - Backend",
    "description": "CRUD de tarefas em Java Spring Boot com PostgreSQL. Execute a pasta CRUD na ordem para capturar automaticamente o ID criado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "tarefaId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "CRUD",
      "item": [
        {
          "name": "1. Criar tarefa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tarefas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Estudar Java\",\n  \"descricao\": \"Revisar Spring Boot e JPA\",\n  \"status\": \"PENDENTE\",\n  \"observacoes\": \"Fazer exercícios\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"tarefaId\", String(pm.response.json().id));",
                  "pm.test(\"Datas automáticas\", function () { pm.expect(pm.response.json()).to.have.property(\"dataCriacao\"); pm.expect(pm.response.json()).to.have.property(\"dataAtualizacao\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Listar tarefas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tarefas?pagina=0&tamanho=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Lista paginada\", function () { pm.expect(pm.response.json().itens).to.be.an(\"array\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Consultar tarefa criada",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tarefas/{{tarefaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Alterar tarefa",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tarefas/{{tarefaId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Estudar Java\",\n  \"descricao\": \"Revisão concluída\",\n  \"status\": \"CONCLUIDA\",\n  \"observacoes\": \"Exercícios realizados\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Status alterado\", function () { pm.expect(pm.response.json().status).to.eql(\"CONCLUIDA\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Filtrar tarefas concluídas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tarefas?status=CONCLUIDA&pagina=0&tamanho=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Excluir tarefa criada",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/tarefas/{{tarefaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });",
                  "pm.test(\"Sem corpo\", function () { pm.expect(pm.response.text()).to.eql(\"\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Validações",
      "item": [
        {
          "name": "Nome em branco",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tarefas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"   \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Status inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tarefas",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Teste inválido\",\n  \"status\": \"OUTRO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "ID inexistente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tarefas/999999999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Paginação inválida",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tarefas?tamanho=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
